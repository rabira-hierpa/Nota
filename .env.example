# Read by the Electron main process only (electron/lib/config.ts).
# The renderer never sees these values.

# VoiceStudio's local speech API. Defaults to the loopback backend.
VOICESTUDIO_URL=http://127.0.0.1:3900

# Only needed when VoiceStudio runs on another machine with an API key.
OMNIVOICE_API_KEY=
