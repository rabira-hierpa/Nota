# Read by the Electron main process only (electron/lib/config.ts), and only in
# development; the renderer never sees these values. Empty means the default.

# amharic-model (default) or voicestudio.
STT_ENGINE=

# Prepared by `npm run setup:amharic-model`; override to use another folder.
AMHARIC_MODEL_DIR=

# Python that runs the model. Defaults to VoiceStudio's runtime interpreter.
VOICESTUDIO_PYTHON=

# VoiceStudio's local speech API, used when STT_ENGINE=voicestudio.
VOICESTUDIO_URL=http://127.0.0.1:3900

# Only needed when VoiceStudio runs on another machine with an API key.
OMNIVOICE_API_KEY=
