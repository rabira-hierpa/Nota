{
  "name": "nota",
  "productName": "Nota",
  "version": "0.2.0",
  "private": true,
  "description": "Offline Amharic notes: write in Markdown, record or dictate, and Hohe transcribes on your own computer.",
  "license": "MIT",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "concurrently -k -n next,main,app -c green,blue,magenta \"npm:dev:renderer\" \"npm:dev:main\" \"npm:dev:app\"",
    "dev:renderer": "next dev -p 3123",
    "dev:main": "tsup --watch",
    "dev:app": "wait-on tcp:3123 file:dist-electron/main.js file:dist-electron/preload.js && cross-env ELECTRON_RENDERER_URL=http://localhost:3123 electron .",
    "build": "next build && tsup",
    "start": "electron .",
    "package": "npm run build && electron-builder",
    "package:mac": "npm run build && electron-builder --mac",
    "package:linux": "npm run build && electron-builder --linux",
    "package:win": "npm run build && electron-builder --win --x64 && electron-builder --win --arm64",
    "typecheck": "tsc --noEmit",
    "lint": "eslint",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "npm run build && playwright test",
    "setup:amharic-model": "node scripts/setup-speech.mjs",
    "setup:hohe": "node scripts/setup-speech.mjs hohe"
  },
  "dependencies": {
    "@hookform/resolvers": "5.9.1",
    "@tiptap/core": "3.32.0",
    "@tiptap/extension-highlight": "3.32.0",
    "@tiptap/extension-list": "3.32.0",
    "@tiptap/extension-text-style": "3.32.0",
    "@tiptap/extensions": "3.32.0",
    "@tiptap/pm": "3.32.0",
    "@tiptap/react": "3.32.0",
    "@tiptap/starter-kit": "3.32.0",
    "@untitledui/icons": "^0.0.22",
    "next": "16.4.3",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-hook-form": "7.90.0",
    "zod": "^4.4.3",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "concurrently": "^10.0.6",
    "cross-env": "^10.1.0",
    "electron": "^45.1.0",
    "electron-builder": "^26.18.0",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "eslint-plugin-sonarjs": "^4.2.0",
    "tailwindcss": "^4",
    "tsup": "^9.0.0",
    "typescript": "^5",
    "vitest": "^4.1.10",
    "wait-on": "^9.5.1"
  },
  "build": {
    "appId": "com.rzcodes.nota",
    "productName": "Nota",
    "copyright": "Copyright © 2026 Rabira Hierpa",
    "artifactName": "${productName}-${version}-${os}-${arch}.${ext}",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist-electron/*.js",
      "out/**",
      "package.json",
      "!node_modules/**/*"
    ],
    "extraResources": [
      {
        "from": "electron/python",
        "to": "python",
        "filter": [
          "*.py"
        ]
      },
      {
        "from": "scripts",
        "to": "setup",
        "filter": [
          "setup-amharic-model.sh",
          "setup-amharic-model.ps1",
          "setup_models.py",
          "speech-requirements.txt"
        ]
      }
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "icon": "build/icon-mac.png",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "identity": "-",
      "hardenedRuntime": false,
      "extendInfo": {
        "NSMicrophoneUsageDescription": "Nota listens while you record or dictate, to turn your speech into Amharic text."
      }
    },
    "dmg": {
      "title": "Nota ${version}"
    },
    "linux": {
      "icon": "build/icons",
      "category": "Office",
      "synopsis": "Offline Amharic notes with dictation and transcription",
      "description": "Write notes in Markdown, record or dictate in Amharic, and transcribe offline with the Hohe speech model.",
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "tar.gz",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ]
    },
    "win": {
      "icon": "build/icon.png",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "Nota",
      "artifactName": "${productName}-${version}-win-${arch}-setup.${ext}"
    }
  },
  "homepage": "https://github.com/rabira-hierpa/Nota"
}
