# Read by the Electron main process only (electron/lib/config.ts), and only in
# development; the renderer never sees these values. Empty means the default.

# Empty offers the local Amharic models (Hohe, BuzzASR); voicestudio uses
# VoiceStudio's engine instead.
STT_ENGINE=

# Prepared by `npm run setup:amharic-model`; override to use other folders.
HOHE_MODEL_DIR=
BUZZASR_MODEL_DIR=

# Python that runs the models. Defaults to Nota's own runtime (made by
# npm run setup:hohe), then VoiceStudio's if installed.
NOTA_PYTHON=

# VoiceStudio's local speech API, used when STT_ENGINE=voicestudio.
VOICESTUDIO_URL=http://127.0.0.1:3900

# Only needed when VoiceStudio runs on another machine with an API key.
OMNIVOICE_API_KEY=
