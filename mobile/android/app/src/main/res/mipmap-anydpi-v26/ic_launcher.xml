<?xml version="1.0" encoding="utf-8"?>
<!-- Android 8+: the feather from build/icon.png on its parchment colour, as
     layers the launcher masks to its own shape. The feather sits inside the
     66 dp safe zone of the 108 dp layer. Android 13+ themed icons tint the
     same feather. Older launchers use mipmap-*/ic_launcher.png. -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/ic_launcher_background" />
    <foreground android:drawable="@mipmap/ic_launcher_foreground" />
    <monochrome android:drawable="@mipmap/ic_launcher_foreground" />
</adaptive-icon>
