{
  "name": "nota",
  "productName": "Nota",
  "version": "0.1.0",
  "private": true,
  "description": "Amharic notes you can write or speak, transcribed locally on your machine.",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "concurrently -k -n next,main,app -c green,blue,magenta \"npm:dev:renderer\" \"npm:dev:main\" \"npm:dev:app\"",
    "dev:renderer": "next dev -p 3123",
    "dev:main": "tsup --watch",
    "dev:app": "wait-on tcp:3123 file:dist-electron/main.js file:dist-electron/preload.js && cross-env ELECTRON_RENDERER_URL=http://localhost:3123 electron .",
    "build": "next build && tsup",
    "start": "electron .",
    "package": "npm run build && electron-builder",
    "typecheck": "tsc --noEmit",
    "lint": "eslint",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "npm run build && playwright test",
    "setup:amharic-model": "bash scripts/setup-amharic-model.sh"
  },
  "dependencies": {
    "@hookform/resolvers": "5.9.1",
    "@tiptap/core": "3.32.0",
    "@tiptap/extension-highlight": "3.32.0",
    "@tiptap/extension-list": "3.32.0",
    "@tiptap/extension-text-style": "3.32.0",
    "@tiptap/extensions": "3.32.0",
    "@tiptap/pm": "3.32.0",
    "@tiptap/react": "3.32.0",
    "@tiptap/starter-kit": "3.32.0",
    "@untitledui/icons": "^0.0.22",
    "next": "16.4.3",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-hook-form": "7.90.0",
    "zod": "^4.4.3",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "concurrently": "^10.0.6",
    "cross-env": "^10.1.0",
    "electron": "^45.1.0",
    "electron-builder": "^26.18.0",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "eslint-plugin-sonarjs": "^4.2.0",
    "tailwindcss": "^4",
    "tsup": "^9.0.0",
    "typescript": "^5",
    "vitest": "^4.1.10",
    "wait-on": "^9.5.1"
  },
  "build": {
    "appId": "com.rzcodes.nota",
    "productName": "Nota",
    "files": [
      "dist-electron/**",
      "out/**",
      "package.json"
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "extendInfo": {
        "NSMicrophoneUsageDescription": "Nota listens while you record or dictate, to turn your speech into Amharic text."
      }
    },
    "extraResources": [
      {
        "from": "electron/python",
        "to": "python",
        "filter": [
          "*.py"
        ]
      }
    ]
  }
}
